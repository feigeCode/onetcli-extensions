{
  "schema_version": 1,
  "id": "com.onetcli.importer.securecrt",
  "name": "SecureCRT Importer",
  "description": "通过 Rust WASM 自动扫描 SecureCRT 配置，导入 SSH 会话并将连接分组转换为 Navop 工作区，同时将 ButtonBar 与 Command Manager 中的 SEND 动作按分组转换为 Navop 快捷命令。不会解密或导入 SecureCRT 加密密码，非 SEND 动作和非 SSH 会话会跳过。 Automatically scans SecureCRT configurations through Rust WASM, imports SSH sessions, converts connection groups into Navop workspaces, and converts grouped SEND actions from Button Bar and Command Manager into Navop quick commands. Encrypted SecureCRT passwords are not decrypted or imported, and non-SEND actions and non-SSH sessions are skipped.",
  "version": "0.1.0",
  "publisher": "Navop",
  "engines": {
    "onetcli": ">=0.7.0"
  },
  "api": {
    "extension": "1.0"
  },
  "runtime": {
    "wasm": [
      {
        "id": "securecrt-importer",
        "module": "wasm/securecrt_importer_wasm.wasm",
        "kind": "component",
        "timeout_ms": 5000,
        "max_memory_mb": 64
      }
    ]
  },
  "permissions": [
    "fs:read:~/Library/Application Support/VanDyke/SecureCRT/Config",
    "fs:read:~/Library/Application Support/VanDyke/Config",
    "fs:read:~/Library/Preferences/VanDyke/Config",
    "fs:read:%APPDATA%/VanDyke/Config",
    "fs:read:~/.vandyke/Config",
    "fs:read:~/.config/VanDyke/Config",
    "fs:read:~/.config/vandyke/Config"
  ],
  "contributes": {
    "connectionImporters": [
      {
        "id": "securecrt",
        "runtimeId": "securecrt-importer",
        "displayName": "SecureCRT",
        "description": "支持自动扫描 SecureCRT 配置，导入 SSH 会话并将连接分组转换为 Navop 工作区，同时导入快捷命令分组；如果扫描结果不正确，请选择相关 XML 或 INI 配置文件。 Automatically scans SecureCRT configurations, imports SSH sessions, converts connection groups into Navop workspaces, and imports grouped quick commands; if the scan result is incorrect, select the relevant XML or INI configuration files.",
        "icon": "terminal",
        "outputKinds": [
          "ssh",
          "quick-command"
        ],
        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "manualFilePick": {
          "prompt": "如果自动扫描结果不正确，请选择相关 SecureCRT XML 或 INI 配置文件"
        },
        "candidateFiles": [
          {
            "id": "securecrt-macos-config",
            "platform": "macos",
            "path": "~/Library/Application Support/VanDyke/SecureCRT/Config"
          },
          {
            "id": "securecrt-macos-legacy-config",
            "platform": "macos",
            "path": "~/Library/Application Support/VanDyke/Config"
          },
          {
            "id": "securecrt-macos-preferences-config",
            "platform": "macos",
            "path": "~/Library/Preferences/VanDyke/Config"
          },
          {
            "id": "securecrt-windows-config",
            "platform": "windows",
            "path": "%APPDATA%/VanDyke/Config"
          },
          {
            "id": "securecrt-linux-config",
            "platform": "linux",
            "path": "~/.vandyke/Config"
          },
          {
            "id": "securecrt-linux-xdg-config",
            "platform": "linux",
            "path": "~/.config/VanDyke/Config"
          },
          {
            "id": "securecrt-linux-xdg-lower-config",
            "platform": "linux",
            "path": "~/.config/vandyke/Config"
          }
        ]
      }
    ]
  }
}
