{
  "id": "rdp",
  "name": "RDP",
  "description": "使用 Rust 开发的 RDP 远程桌面 Provider，为 Navop 提供交互式远程会话、动态分辨率、文本/文件剪贴板、远端音频和光标同步能力。 Rust-based RDP provider for Navop with interactive remote sessions, dynamic resizing, text/file clipboard, remote audio, and cursor synchronization.",
  "version": "0.3.7",
  "protocol": "rdp",
  "entry": {
    "command": "./navop-rdp-helper",
    "args": [],
    "working_dir": null
  },
  "capabilities": {
    "resize": "remote_resize",
    "clipboard_text": true,
    "cursor_shape": true,
    "audio": true,
    "file_transfer": true,
    "audio_playback": true,
    "audio_capture": false,
    "clipboard_files_to_remote": true,
    "clipboard_files_from_remote": true,
    "clipboard_directories_to_remote": true,
    "clipboard_directories_from_remote": true,
    "shared_drives": false
  },
  "ui": {
    "icon": "Monitor",
    "default_port": 3389
  }
}
